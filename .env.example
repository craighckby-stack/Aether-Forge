# ==============================================================================
# ARCHITECTURAL ENVIRONMENT SPECIFICATION
# Role: Configuration template for DARLEK CANN / AI Agent OS runtime kernel.
# Integration: Consumed by runtime environment loaders, lib/env-validator.ts,
#              and system diagnostic engine for multi-agent synthesis.
# ==============================================================================

# ------------------------------------------------------------------------------
# PRIMARY AI PROVIDER (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini Pro/Flash model execution & reasoning.
# AI Studio automatically injects this at runtime from user secrets.
# For local development: Provide your Google AI Studio API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# HOSTING & NETWORK TOPOLOGY
# ------------------------------------------------------------------------------
# APP_URL: Base URL where this application is hosted and accessible.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, SSE streaming, and API endpoints.
APP_URL="http://localhost:3000"

# NODE_ENV: Runtime execution environment ("development" | "production" | "test")
NODE_ENV="development"

# ------------------------------------------------------------------------------
# FALLBACK & MULTI-AGENT LLM PROVIDERS (OPTIONAL)
# Siphoned from craighckby-stack/AI_Agent_OS multi-provider fallback architecture
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Optional secondary provider fallback (GPT-4o, o3-mini)
OPENAI_API_KEY=""

# DEEPSEEK_API_KEY: Optional DeepSeek reasoning provider fallback (DeepSeek-R1 / V3)
DEEPSEEK_API_KEY=""

# ANTHROPIC_API_KEY: Optional Claude reasoning provider fallback
ANTHROPIC_API_KEY=""

# LOCAL_LLM_ENDPOINT: Local inference server endpoint (Ollama / vLLM / llama.cpp / Termux)
LOCAL_LLM_ENDPOINT="http://localhost:11434"

# ------------------------------------------------------------------------------
# ZERO-LEAK SANDBOX & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# CONSENSUS_WEIGHT_THRESHOLD: Minimum confidence score (0.00 - 1.00) required for mutation consensus
CONSENSUS_WEIGHT_THRESHOLD="0.75"

# SANDBOX_MEMORY_LIMIT_MB: Hard heap memory allocation cap for isolated code execution
SANDBOX_MEMORY_LIMIT_MB="512"

# MEMORY_STORE_PATH: Directory path for flat-file agent episodic and vector memory persistence
MEMORY_STORE_PATH="./memory"

# ENABLE_TELEMETRY: Toggle real-time performance telemetry and diagnostic metrics collection (true | false)
ENABLE_TELEMETRY="true"